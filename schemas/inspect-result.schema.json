{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inspect 2 response",
  "type": "object",
  "required": [
    "apiVersion",
    "operation",
    "status",
    "observedAt",
    "root",
    "responseRevision",
    "data",
    "diagnostics"
  ],
  "properties": {
    "apiVersion": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 2
        },
        "minor": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "observedAt": {
      "type": "string"
    },
    "root": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "diagnostics": {
      "type": "array"
    },
    "responseRevision": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "workspace": {
      "type": "object",
      "required": [
        "mode",
        "identity",
        "repositories",
        "protocol"
      ],
      "properties": {},
      "additionalProperties": true
    },
    "items": {
      "type": "object",
      "required": [
        "items",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array"
        },
        "page": {
          "type": "object",
          "required": [
            "offset",
            "limit",
            "total",
            "hasMore"
          ],
          "properties": {
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "hasMore": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "projection": {
      "type": "object",
      "required": [
        "view",
        "slug",
        "stateRevision"
      ],
      "properties": {
        "view": {
          "enum": [
            "summary",
            "task",
            "change",
            "flow"
          ]
        },
        "summary": {
          "type": "object",
          "required": [
            "slug",
            "status",
            "stateRevision",
            "progress",
            "reviews",
            "verification",
            "documents"
          ],
          "properties": {
            "slug": {
              "type": "string"
            },
            "status": {
              "enum": [
                "active",
                "paused",
                "done",
                "cancelled"
              ]
            },
            "progress": {
              "type": "object",
              "required": [
                "completed",
                "total"
              ],
              "properties": {
                "completed": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                }
              },
              "additionalProperties": true
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "role",
                  "path",
                  "documentRevision"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "documentRevision": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "tasks": {
          "type": "array"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "path",
              "documentRevision"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "documentRevision": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": [
        "slug",
        "path",
        "documentRevision",
        "content",
        "bytes",
        "lineCount"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "lineCount": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": [
        "slug",
        "stateRevision",
        "recordedResult",
        "applicability",
        "repositoryStates",
        "record"
      ],
      "properties": {
        "recordedResult": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "unknown"
          ]
        },
        "applicability": {
          "enum": [
            "not_checked",
            "missing",
            "valid",
            "invalid",
            "unknown"
          ]
        },
        "record": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "handoff": {
      "type": "object",
      "required": [
        "slug",
        "content",
        "estimatedTokens",
        "sources",
        "stateRevision",
        "progression"
      ],
      "properties": {},
      "additionalProperties": true
    },
    "search": {
      "type": "object",
      "required": [
        "query",
        "items",
        "page"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "items": {
          "type": "array"
        },
        "page": {
          "type": "object",
          "required": [
            "offset",
            "limit",
            "total",
            "hasMore"
          ],
          "properties": {
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "hasMore": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "required": [
        "enabled",
        "configState",
        "extensions"
      ],
      "properties": {},
      "additionalProperties": true
    },
    "runs": {
      "type": "object",
      "required": [
        "items",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array"
        },
        "page": {
          "type": "object",
          "required": [
            "offset",
            "limit",
            "total",
            "hasMore"
          ],
          "properties": {
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "hasMore": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "records",
        "attempts"
      ],
      "properties": {},
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "schemaVersion",
        "itemSlug",
        "scope",
        "result",
        "checks"
      ],
      "properties": {},
      "additionalProperties": true
    }
  }
}
