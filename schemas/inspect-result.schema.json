{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbench Inspect v1",
  "$comment": "先校验信封；非error时根据operation校验同名$defs。数据字段允许未来minor添加；rawRecord仅接受已声明记录字段。",
  "$defs": {
    "apiVersion": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1,
          "type": "integer"
        },
        "minor": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableRevision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message",
        "scope",
        "subject",
        "path",
        "line",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "documentDiagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "path",
        "line",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": [
        "offset",
        "limit",
        "total",
        "hasMore"
      ],
      "properties": {
        "offset": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "hasMore": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "required": [
        "parsed",
        "diagnostics"
      ],
      "properties": {
        "parsed": {
          "type": "integer"
        },
        "diagnostics": {
          "type": "integer"
        }
      },
      "additionalProperties": {
        "type": "integer"
      }
    },
    "list": {
      "type": "object",
      "required": [
        "items",
        "counts",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "page": {
          "$ref": "#/$defs/page"
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "workBase",
        "testTarget",
        "hotfixBase",
        "namePattern"
      ],
      "properties": {
        "workBase": {
          "type": "string"
        },
        "testTarget": {
          "type": [
            "string",
            "null"
          ]
        },
        "hotfixBase": {
          "type": [
            "string",
            "null"
          ]
        },
        "namePattern": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "policySource": {
      "type": "object",
      "required": [
        "source",
        "path",
        "pointer"
      ],
      "properties": {
        "source": {
          "enum": [
            "kit-default",
            "workspace",
            "repository"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "pointer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "required": [
        "id",
        "role",
        "absolutePath",
        "aliases",
        "category",
        "description",
        "availability",
        "effectiveBranchPolicy",
        "policySources"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "kit",
            "business"
          ]
        },
        "absolutePath": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "availability": {
          "enum": [
            "present",
            "missing",
            "invalid"
          ]
        },
        "effectiveBranchPolicy": {
          "$ref": "#/$defs/policy"
        },
        "policySources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/policySource"
          }
        }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "required": [
        "maxFileBytes",
        "maxResponseBytes",
        "maxPageSize",
        "maxDirectoryEntries"
      ],
      "properties": {
        "maxFileBytes": {
          "type": "integer"
        },
        "maxResponseBytes": {
          "type": "integer"
        },
        "maxPageSize": {
          "type": "integer"
        },
        "maxDirectoryEntries": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "protocol": {
      "type": "object",
      "required": [
        "apiVersion",
        "kitVersion",
        "operations",
        "limits"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kitVersion": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "workspace",
              "features",
              "feature",
              "document",
              "verification",
              "workflow",
              "runs",
              "run"
            ]
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "additionalProperties": true
    },
    "localContext": {
      "type": "object",
      "required": [
        "activeFeature",
        "branchOwner",
        "primaryRole",
        "sources"
      ],
      "properties": {
        "activeFeature": {
          "type": [
            "string",
            "null"
          ]
        },
        "branchOwner": {
          "type": [
            "string",
            "null"
          ]
        },
        "primaryRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "configuration": {
      "type": "object",
      "required": [
        "providers",
        "repositoryOverrides",
        "unknownExtensionConfig"
      ],
      "properties": {
        "providers": {
          "type": "object"
        },
        "repositoryOverrides": {
          "type": "object"
        },
        "unknownExtensionConfig": {
          "type": "object",
          "required": [
            "keys",
            "valuesOmitted"
          ],
          "properties": {
            "keys": {
              "type": [
                "array",
                "object"
              ]
            },
            "valuesOmitted": {
              "const": true,
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "workspace": {
      "type": "object",
      "required": [
        "mode",
        "identity",
        "repositories",
        "localContext",
        "configuration",
        "protocol"
      ],
      "properties": {
        "mode": {
          "enum": [
            "maintenance",
            "workspace"
          ]
        },
        "identity": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repository"
          }
        },
        "localContext": {
          "$ref": "#/$defs/localContext"
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        }
      },
      "additionalProperties": true
    },
    "binding": {
      "type": "object",
      "required": [
        "repository",
        "workBranch",
        "baseBranch",
        "source"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "workBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "planSummary": {
      "type": "object",
      "required": [
        "exists",
        "completed",
        "total",
        "diagnostics"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "completed": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "completionPolicy": {
          "type": [
            "string",
            "null"
          ]
        },
        "trustedProgress": {
          "$ref": "#/$defs/trustedProgress"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentDiagnostic"
          }
        }
      },
      "additionalProperties": true
    },
    "featureSummary": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "titleSource",
        "status",
        "path",
        "lastUpdated",
        "repositoryBindings",
        "planSummary",
        "documentReviews",
        "verificationSummary"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "titleSource": {
          "enum": [
            "heading",
            "slug"
          ]
        },
        "status": {
          "enum": [
            "planning",
            "development",
            "testing",
            "paused",
            "done"
          ]
        },
        "path": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string"
        },
        "repositoryBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "planSummary": {
          "$ref": "#/$defs/planSummary"
        },
        "documentReviews": {
          "type": "object",
          "required": [
            "requirements",
            "design",
            "plan"
          ],
          "properties": {
            "requirements": {
              "type": "string"
            },
            "design": {
              "type": "string"
            },
            "plan": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "verificationSummary": {
          "type": "object",
          "required": [
            "exists",
            "codeState"
          ],
          "properties": {
            "exists": {
              "type": "boolean"
            },
            "codeState": {
              "enum": [
                "not_checked"
              ]
            },
            "recordedResult": {
              "enum": [
                "passed",
                "failed",
                "unknown"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "required": [
        "items",
        "counts",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/featureSummary"
          }
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "page": {
          "$ref": "#/$defs/page"
        }
      },
      "additionalProperties": true
    },
    "location": {
      "type": "object",
      "required": [
        "path",
        "startLine",
        "endLine"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "startLine": {
          "type": "integer"
        },
        "endLine": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "trustedProgress": {
      "type": "object",
      "required": [
        "applicable",
        "completed",
        "total"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "completed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "deliverable": {
      "type": "object",
      "required": [
        "repository",
        "kind",
        "path",
        "symbol",
        "line"
      ],
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "Create",
            "Modify",
            "Test",
            "Delete",
            "Verify"
          ]
        },
        "path": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "taskEvidence": {
      "type": "object",
      "required": [
        "taskId",
        "trusted",
        "source",
        "diagnostics"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "trusted": {
          "type": "boolean"
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "startLine": {
              "type": "integer"
            },
            "endLine": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentDiagnostic"
          }
        }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "completed",
        "dependencies",
        "references",
        "startLine",
        "endLine",
        "path",
        "revision"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "validationKind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "行为",
            "声明式",
            "持久化",
            null
          ]
        },
        "deliverables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deliverable"
          }
        },
        "trusted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidenceSource": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "startLine": {
              "type": "integer"
            },
            "endLine": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "evidenceDiagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentDiagnostic"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "startLine": {
          "type": "integer"
        },
        "endLine": {
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/nullableRevision"
        }
      },
      "additionalProperties": true
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "exists",
        "type"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnostic"
        }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "type"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "nextAction": {
      "type": "object",
      "required": [
        "stage",
        "runbook",
        "reason",
        "confirmation"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "runbook": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "confirmation": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "progression": {
      "type": "object",
      "required": [
        "state",
        "currentStage",
        "nextActions",
        "blockers"
      ],
      "properties": {
        "state": {
          "enum": [
            "known",
            "needs_code_check",
            "historical"
          ]
        },
        "currentStage": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nextAction"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "feature": {
      "type": "object",
      "required": [
        "summary",
        "tasks",
        "files",
        "artifacts",
        "description",
        "progression",
        "featureRevision"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/featureSummary"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "description": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "content",
            "line",
            "truncated"
          ],
          "properties": {
            "content": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "progression": {
          "$ref": "#/$defs/progression"
        },
        "featureRevision": {
          "$ref": "#/$defs/revision"
        }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": [
        "slug",
        "path",
        "mediaType",
        "revision",
        "bytes",
        "lineCount",
        "content"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "bytes": {
          "type": "integer"
        },
        "lineCount": {
          "type": "integer"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "batch": {
      "type": "object",
      "required": [
        "id",
        "recordedAt",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/location"
        }
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "source",
        "workingDirectory",
        "command",
        "exitStatus",
        "result",
        "duration",
        "testCount"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/location"
        },
        "workingDirectory": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "exitStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "testCount": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "verificationIssue": {
      "type": "object",
      "required": [
        "code",
        "message",
        "path",
        "line"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "selectedBatch": {
