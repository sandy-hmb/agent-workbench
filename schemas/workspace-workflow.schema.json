{
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "actionRef": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "uses"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "before": {
          "$ref": "#/$defs/id"
        },
        "after": {
          "$ref": "#/$defs/id"
        },
        "uses": {
          "$ref": "#/$defs/actionRef"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "manual",
            "auto"
          ]
        },
        "with": {
          "type": "object"
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "workflow",
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": true,
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "type": "integer"
        }
      }
    },
    "workflow": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  }
}
