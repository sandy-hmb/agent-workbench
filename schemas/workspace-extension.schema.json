{
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1},
    "capability": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$", "minLength": 3},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\r\\n])(?!.*\\x00)(?!/)(?!.*[A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*file://)(?!.*@(?:[A-Za-z]:|/|\\\\|\\.\\.(?:/|$)))(?!.*--(?:config|file|path|script|cwd|dir|directory)=(?:/|\\\\|\\.\\.))(?!.*-[Cf](?:/|\\\\|\\.\\.))(?!\\s*$)[^\\r\\n]+$"}},
    "environment": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "minLength": 1}},
    "effect": {"type": "string", "enum": ["read", "write", "network", "command", "filesystem.read", "filesystem.write", "process.exec", "git.read", "git.write", "policy.read", "policy.write"]},
    "effects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/effect"}},
    "confirmation": {"type": "object", "required": ["title", "summary"], "additionalProperties": false, "properties": {"title": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\r\\n])(?!.*\\x00)(?!\\s*$).+$"}, "summary": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\r\\n])(?!.*\\x00)(?!\\s*$).+$"}}},
    "provider": {
      "type": "object",
      "required": ["capability", "provider", "apiVersion", "skill"],
      "additionalProperties": false,
      "properties": {
        "capability": {"$ref": "#/$defs/capability"},
        "provider": {"$ref": "#/$defs/id"},
        "apiVersion": {"type": "integer", "const": 1},
        "skill": {"$ref": "#/$defs/id"},
        "command": {"$ref": "#/$defs/command"},
        "environment": {"$ref": "#/$defs/environment"}
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "apiVersion", "skill", "confirmation", "effects"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "apiVersion": {"type": "integer", "const": 1},
        "skill": {"$ref": "#/$defs/id"},
        "confirmation": {"$ref": "#/$defs/confirmation"},
        "command": {"$ref": "#/$defs/command"},
        "environment": {"$ref": "#/$defs/environment"},
        "effects": {"$ref": "#/$defs/effects"}
      }
    }
  },
  "type": "object",
  "required": ["schemaVersion", "id", "version", "kitApi", "provides", "requires", "effects"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "kitApi": {"type": "integer", "const": 1},
    "provides": {"type": "array", "items": {"$ref": "#/$defs/provider"}, "uniqueItems": true},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}, "uniqueItems": true},
    "requires": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
    "configSchema": {"type": "string", "minLength": 1, "pattern": "^(?!.*\\x00)(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\s).+$"},
    "effects": {"$ref": "#/$defs/effects"}
  }
}
