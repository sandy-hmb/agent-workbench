{
  "$defs": {"diagnostic": {"type": "object", "required": ["level", "code", "message"], "additionalProperties": false, "properties": {"level": {"type": "string", "enum": ["info", "warning", "error"]}, "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "message": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"}, "evidence": {}}}, "effect": {"type": "object"}},
