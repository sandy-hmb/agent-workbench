  "properties": {"apiVersion": {"type": "integer", "const": 1}, "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"}, "status": {"type": "string", "enum": ["ok", "blocked", "failed"]}, "result": {}, "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}, "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}}
